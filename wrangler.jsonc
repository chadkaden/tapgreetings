{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tapgreetings",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git",
      ".git/**",
      "node_modules",
      "node_modules/**",
      "scratch",
      "scratch/**"
    ]
  }
}
