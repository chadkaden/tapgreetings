{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tapgreetings",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "exclude": [
      ".git",
      ".git/**",
      ".wrangler",
      ".wrangler/**",
      "node_modules",
      "node_modules/**",
      "theme",
      "theme/**",
      "scripts",
      "scripts/**",
      "scratch",
      "scratch/**"
    ]
  }
}
