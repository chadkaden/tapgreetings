/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

/assets/video/*
  Cache-Control: public, max-age=2592000, immutable
  Accept-Ranges: bytes
  Access-Control-Allow-Origin: *

/assets/img/*
  Cache-Control: public, max-age=600, must-revalidate
  Access-Control-Allow-Origin: *

/public/*
  Cache-Control: public, max-age=2592000, immutable
  Access-Control-Allow-Origin: *
