            <strong>⚡ Rewritable NTAG215 Microchip:</strong> Want to personalize this card? It can easily be reprogrammed to link to your own custom family holiday video, voice note, photos, or personalized greeting anytime using our free Web NFC Tool at <a href="https://shop.tapthingy.com/pages/tap-thingy-tools-nfc-reprogram-webtool-and-guide" target="_blank" style="color: var(--tg-gold); font-weight: 700; text-decoration: underline;">/tools</a> (or the NFC Tools app on iPhone &amp; Android).
          </p>
        </div>

        <div class="tg-raw-desc">
          {{ product.description }}
        </div>
      </div>
    </details>

    <!-- 2. Technical Specs Accordion -->
    <details open class="tg-details">
      <summary class="tg-summary">
        <span>🛡️ Hardware Specs &amp; NFC Technology</span>
        <span class="tg-icon">&#9660;</span>
      </summary>
      <div style="padding-top: 14px;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.92rem; text-align: left;">
          <tbody>
            <tr style="border-bottom: 1px solid var(--tg-border);">
              <td style="padding: 10px 0; font-weight: 700; color: var(--tg-gold); width: 40%;">Smartphone Compatibility:</td>
              <td style="padding: 10px 0; color: var(--tg-text);">100% Compatible with iPhone (XS through 16 Pro) &amp; all Android devices (Zero app required).</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--tg-border);">
              <td style="padding: 10px 0; font-weight: 700; color: var(--tg-gold);">Card Format &amp; Specs:</td>
              <td style="padding: 10px 0; color: var(--tg-text);">CR80 Standard Credit Card Dimensions (85.6mm &times; 53.98mm &times; 0.76mm / 30 mil).</td>
            </tr>
            
            <tr style="border-bottom: 1px solid var(--tg-border);">
              <td style="padding: 12px 0; font-weight: 700; color: var(--tg-gold); vertical-align: top;">Live Web Experience:</td>
              <td style="padding: 12px 0; color: var(--tg-text);">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                  <div>
                    <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--tg-text-muted); font-weight: 700;">TapGreetings Portal:</span><br>
                    <a href="{{ web_portal_url }}" target="_blank" style="color: var(--tg-gold); font-weight: 700; text-decoration: underline; word-break: break-all;">
                      {{ web_portal_url }}
                    </a>
                  </div>
                  <div>
                    <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--tg-text-muted); font-weight: 700;">Shop Living Experience Page:</span><br>
                    <a href="{{ shopify_entertainment_page_url }}" target="_blank" style="color: #60A5FA; font-weight: 800; text-decoration: underline; word-break: break-all;">
                      {{ shopify_entertainment_page_url }}
                    </a>
                  </div>
                </div>
              </td>
            </tr>
            <tr>
              <td style="padding: 10px 0; font-weight: 700; color: var(--tg-gold);">Official Series:</td>
              <td style="padding: 10px 0; color: var(--tg-text);">TapGreetings Series 1 &bull; {{ subcol_name }} &bull; Card #{{ card_code }} of 016</td>
            </tr>
          </tbody>
        </table>
      </div>
    </details>

    <!-- 3. Primary Purchase Action Box -->
    <div class="tg-buy-box">
      <div class="tg-price-row">
        <span class="tg-current-price">{{ product.selected_or_first_available_variant.price | money }}</span>
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <span class="tg-compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          <span class="tg-save-badge">Save $10.00</span>
        {% endif %}
      </div>

      <div style="color: #4ADE80; font-weight: 700; font-size: 0.92rem; margin-bottom: 16px;">
        &#10004; In Stock &bull; Ready to Ship (Holiday Series 1)
      </div>

      {% form 'product', product, id: 'tg-buy-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <div style="display: flex; gap: 12px; justify-content: center; align-items: center; max-width: 440px; margin: 0 auto; flex-wrap: wrap;">
          <div style="background: rgba(255, 255, 255, 0.08); border: 1.5px solid var(--tg-border); border-radius: 30px; padding: 4px 16px; display: flex; align-items: center;">
