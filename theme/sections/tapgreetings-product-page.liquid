{% comment %}
  TapGreetings Series 1: Custom Product Sales Page Section
  Handcrafted Polymer Clay & Needle-Felt Holiday Collection
  Features:
    - 9:16 Uncropped Stop-Motion Video Player with persistent sound toggle
    - Front & Back 2K Digital Artwork Viewer
    - Mobile NFC Tap Demonstration Video (Featuring Ghost Tap Demo across all cards)
    - Full Dark Mode & High-Contrast Light Mode Support (Zero faint text or white-on-white bugs)
    - Direct Add to Cart Form, Quantity Selector, and Share Modal
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Inter:wght@400;500;600;700;800&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet">

{% assign card_code = '001' %}
{% if product.tags contains 'card-001' or product.title contains '#001' %}
  {% assign card_code = '001' %}
{% elsif product.tags contains 'card-002' or product.title contains '#002' %}
  {% assign card_code = '002' %}
{% elsif product.tags contains 'card-003' or product.title contains '#003' %}
  {% assign card_code = '003' %}
{% elsif product.tags contains 'card-004' or product.title contains '#004' %}
  {% assign card_code = '004' %}
{% elsif product.tags contains 'card-005' or product.title contains '#005' %}
  {% assign card_code = '005' %}
{% elsif product.tags contains 'card-006' or product.title contains '#006' %}
  {% assign card_code = '006' %}
{% elsif product.tags contains 'card-007' or product.title contains '#007' %}
  {% assign card_code = '007' %}
{% elsif product.tags contains 'card-008' or product.title contains '#008' %}
  {% assign card_code = '008' %}
{% elsif product.tags contains 'card-009' or product.title contains '#009' %}
  {% assign card_code = '009' %}
{% elsif product.tags contains 'card-010' or product.title contains '#010' %}
  {% assign card_code = '010' %}
{% elsif product.tags contains 'card-011' or product.title contains '#011' %}
  {% assign card_code = '011' %}
{% elsif product.tags contains 'card-012' or product.title contains '#012' %}
  {% assign card_code = '012' %}
{% elsif product.tags contains 'card-013' or product.title contains '#013' %}
  {% assign card_code = '013' %}
{% elsif product.tags contains 'card-014' or product.title contains '#014' %}
  {% assign card_code = '014' %}
{% elsif product.tags contains 'card-015' or product.title contains '#015' %}
  {% assign card_code = '015' %}
{% elsif product.tags contains 'card-016' or product.title contains '#016' %}
  {% assign card_code = '016' %}
{% else %}
  {% if product.sku contains 'TG-S1-' %}
    {% assign sku_parts = product.sku | split: 'TG-S1-' %}
    {% assign card_code = sku_parts.last %}
  {% elsif product.title contains '#' %}
    {% assign title_parts = product.title | split: '#' %}
    {% assign num_part = title_parts[1] | split: ' ' %}
    {% assign card_code = num_part[0] %}
  {% endif %}
{% endif %}

{% assign subcol_name = 'Series 1 Collection' %}
{% assign subcol_handle = 'tapgreetings-series-1' %}
{% assign subcol_emoji = '🎄' %}
{% if product.tags contains 'Classic Icons' %}
  {% assign subcol_name = 'Classic Icons' %}
  {% assign subcol_handle = 'series-1-classic-icons' %}
  {% assign subcol_emoji = '🎅' %}
{% elsif product.tags contains 'Winter Magic' %}
  {% assign subcol_name = 'Winter Magic' %}
  {% assign subcol_handle = 'series-1-winter-magic' %}
  {% assign subcol_emoji = '❄️' %}
{% elsif product.tags contains 'Hearth & Holiday' %}
  {% assign subcol_name = 'Hearth & Holiday' %}
  {% assign subcol_handle = 'series-1-hearth-holiday' %}
  {% assign subcol_emoji = '🔥' %}
{% elsif product.tags contains 'Festive Friends' %}
  {% assign subcol_name = 'Festive Friends' %}
  {% assign subcol_handle = 'series-1-festive-friends' %}
  {% assign subcol_emoji = '🐾' %}
{% endif %}

{% assign video_filename = 'tapgreeting_' | append: card_code | append: '.mp4' %}
{% assign video_url = video_filename | asset_url %}
{% assign tap_demo_url = 'card_01_tap.mp4' | asset_url %}
{% assign web_portal_url = 'https://tapgreetings.com/' | append: card_code | append: '/' %}
{% if product.tags contains 'pinkoween' or product.handle contains 'pink-o-ween' %}
  {% assign shopify_entertainment_page_url = 'https://shop.tapthingy.com/pages/tgpow-' | append: card_code %}
{% else %}
  {% assign shopify_entertainment_page_url = 'https://shop.tapthingy.com/pages/tghh' | append: card_code %}
{% endif %}

{% assign front_img_url = '' %}
{% assign back_img_url = '' %}
{% if product.images.size > 0 %}
  {% assign front_img_url = product.images[0] | image_url: width: 1200 %}
  {% if product.images.size > 1 %}
    {% assign back_img_url = product.images[1] | image_url: width: 1200 %}
  {% else %}
    {% assign back_img_url = front_img_url %}
  {% endif %}
{% endif %}

<style>
  /* --- TAPGREETINGS SERIES 1 THEMING --- */
  .tg-product-wrapper {
    --tg-bg: #140C08;
    --tg-surface: #1E130D;
    --tg-surface-card: rgba(255, 255, 255, 0.05);
    --tg-border: rgba(251, 191, 36, 0.28);
    --tg-border-active: #FBBF24;
    --tg-text: #F5EBE1;
    --tg-text-muted: #D1BDB0;
    --tg-heading: #FFF8E7;
    --tg-gold: #FBBF24;
    --tg-gold-glow: rgba(251, 191, 36, 0.45);
    --tg-red: #D62839;
    --tg-red-dark: #9E1B32;
    --tg-shadow: rgba(0, 0, 0, 0.5);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    padding: 16px 16px 48px;
    background: var(--tg-bg) !important;
    color: var(--tg-text) !important;
    transition: background-color 0.3s ease, color 0.3s ease;
    box-sizing: border-box;
  }

  body.tt-light-mode .tg-product-wrapper {
    --tg-bg: #FFFDF7;
    --tg-surface: #FDF6EE;
    --tg-surface-card: #FFFFFF;
    --tg-border: #E8D5C4;
    --tg-border-active: #9E1B32;
    --tg-text: #2D1A10;
    --tg-text-muted: #6B4226;
    --tg-heading: #9E1B32;
    --tg-gold: #B45309;
    --tg-gold-glow: rgba(180, 83, 9, 0.2);
    --tg-red: #D62839;
    --tg-red-dark: #9E1B32;
    --tg-shadow: rgba(61, 35, 20, 0.08);
    background: var(--tg-bg) !important;
    color: var(--tg-text) !important;
  }

  .tg-product-wrapper * {
    box-sizing: border-box;
  }

  .tg-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Top Nav */
  .tg-top-nav {
    margin-bottom: 14px;
    padding: 4px 0;
  }
  .tg-top-nav a {
    color: var(--tg-gold) !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: opacity 0.2s;
  }
  .tg-top-nav a:hover {
    opacity: 0.85;
  }

  /* Header Badges */
  .tg-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #9E1B32, #D62839, #E65100, #FBBF24, #9E1B32) !important;
    background-size: 300% 300% !important;
    animation: badgeSweep 6s ease infinite !important;
    color: #FFFFFF !important;
    padding: 7px 20px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    box-shadow: 0 4px 18px rgba(214, 40, 57, 0.45);
    margin-bottom: 10px;
  }

  .tg-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.85rem;
    font-weight: 900;
    color: var(--tg-heading) !important;
    margin: 0 0 10px 0;
    line-height: 1.25;
  }

  .tg-subcol-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--tg-surface-card) !important;
    border: 1.5px solid var(--tg-border) !important;
    color: var(--tg-gold) !important;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 16px;
  }

  /* Dynamic Media Showcase Container: Expands for 9:16 Video, Shrinks for CR80 Card Art */
  .tg-media-box {
    position: relative;
    width: 100%;
    margin: 0 auto 16px;
    border-radius: 20px;
    overflow: hidden;
    background: #000000;
    border: 2.5px solid var(--tg-border-active);
    box-shadow: 0 10px 35px var(--tg-shadow);
    animation: mediaAuraPulse 4s ease-in-out infinite;
    transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1), aspect-ratio 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* When Video is active (Slide 1 or Slide 4): Enlarge container to fit 9:16 portrait video */
  .tg-media-box.is-video {
    max-width: 460px;
    aspect-ratio: 9 / 16;
  }

  /* When Card Image is active (Slide 2 or Slide 3): Shrink container to exact CR80 physical credit card size */
  .tg-media-box.is-card {
    max-width: 380px;
    aspect-ratio: 53.98 / 85.60;
  }

  .tg-slide {
    width: 100%;
    height: 100%;
    display: none;
    position: relative;
  }
  .tg-slide.active-slide {
    display: block;
  }
  .tg-slide video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tg-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    background: #140C08;
  }

  .tg-sound-toggle-btn {
    position: absolute;
    bottom: 14px;
    right: 14px;
    z-index: 20;
    background: rgba(20, 12, 8, 0.85);
    border: 1.5px solid var(--tg-gold);
    color: var(--tg-gold);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 1.15rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
    transition: transform 0.2s, background 0.2s;
  }
  .tg-sound-toggle-btn:hover {
    transform: scale(1.08);
    background: rgba(20, 12, 8, 0.98);
  }

  /* Thumbnail Reel */
  .tg-thumb-reel {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: nowrap;
    overflow-x: auto;
    padding: 4px 4px 10px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    margin-bottom: 24px;
  }
  .tg-thumb-btn {
    flex: 0 0 74px;
    width: 74px;
    height: 74px;
    border-radius: 14px;
    background: var(--tg-surface-card);
    border: 2px solid var(--tg-border);
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--tg-text);
  }
  .tg-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tg-thumb-btn.active {
    border-color: var(--tg-border-active) !important;
    animation: thumbGlowPulse 2.5s ease-in-out infinite alternate !important;
    transform: translateY(-2px);
  }
  .tg-thumb-label {
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--tg-gold);
    margin-top: 2px;
  }

  /* Collapsible Details */
  .tg-details {
    background: var(--tg-surface-card) !important;
    border: 1.5px solid var(--tg-border) !important;
    border-radius: 20px;
    padding: 16px 20px;
    margin-bottom: 20px;
    box-shadow: 0 4px 16px var(--tg-shadow);
  }
  .tg-summary {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--tg-heading) !important;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }
  .tg-details[open] .tg-icon {
    transform: rotate(180deg);
  }
  .tg-icon {
    transition: transform 0.2s ease;
    color: var(--tg-gold);
    font-size: 0.9rem;
  }

  /* Quotes & Descriptions */
  .tg-motto-quote {
    border-left: 4px solid var(--tg-gold) !important;
    background: rgba(251, 191, 36, 0.08) !important;
    margin: 16px 0;
    padding: 12px 18px;
    border-radius: 0 12px 12px 0;
    font-style: italic;
    color: var(--tg-gold) !important;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  /* Category Tag Box - High contrast in both Dark and Light modes */
  .tg-category-box,
  .tg-raw-desc div[style*="background: #FFF8E7"],
  .tg-raw-desc div[style*="background:#FFF8E7"] {
    background: rgba(251, 191, 36, 0.08) !important;
    border: 1px solid rgba(251, 191, 36, 0.35) !important;
    border-radius: 12px !important;
    padding: 14px 18px !important;
    margin-top: 24px !important;
  }
  .tg-category-box p,
  .tg-raw-desc div[style*="background: #FFF8E7"] p,
  .tg-raw-desc div[style*="background:#FFF8E7"] p {
    color: #FBBF24 !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    margin: 0 !important;
  }
  .tg-category-box strong,
  .tg-raw-desc div[style*="background: #FFF8E7"] strong,
  .tg-raw-desc div[style*="background:#FFF8E7"] strong {
    color: #FFFFFF !important;
  }
  body.tt-light-mode .tg-category-box,
  body.tt-light-mode .tg-raw-desc div[style*="background: #FFF8E7"],
  body.tt-light-mode .tg-raw-desc div[style*="background:#FFF8E7"] {
    background: #FFF8E7 !important;
    border: 1px solid #FDE68A !important;
  }
  body.tt-light-mode .tg-category-box p,
  body.tt-light-mode .tg-raw-desc div[style*="background: #FFF8E7"] p,
  body.tt-light-mode .tg-raw-desc div[style*="background:#FFF8E7"] p {
    color: #92400E !important;
  }
  body.tt-light-mode .tg-category-box strong,
  body.tt-light-mode .tg-raw-desc div[style*="background: #FFF8E7"] strong,
  body.tt-light-mode .tg-raw-desc div[style*="background:#FFF8E7"] strong {
    color: #78350F !important;
  }

  /* Buy Action Box */
  .tg-buy-box {
    background: linear-gradient(135deg, #1E130D, #2B161B) !important;
    border: 2px solid var(--tg-border-active) !important;
    border-radius: 24px;
    padding: 28px 20px;
    text-align: center;
    box-shadow: 0 8px 30px var(--tg-shadow);
    margin-bottom: 24px;
  }
  body.tt-light-mode .tg-buy-box {
    background: #FFFFFF !important;
    border-color: #9E1B32 !important;
    box-shadow: 0 4px 20px rgba(158, 27, 50, 0.12);
  }

  .tg-price-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .tg-current-price {
    font-family: 'Outfit', sans-serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: #FBBF24 !important;
  }
  body.tt-light-mode .tg-current-price {
    color: #9E1B32 !important;
  }
  .tg-compare-price {
    font-size: 1.3rem;
    text-decoration: line-through;
    color: var(--tg-text-muted) !important;
  }
  .tg-save-badge {
    background: #D62839 !important;
    color: #FFFFFF !important;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .tg-add-to-cart-btn {
    width: 100%;
    max-width: 440px;
    background: linear-gradient(135deg, #9E1B32, #D62839, #E65100, #FBBF24, #D62839) !important;
    background-size: 250% 250% !important;
    animation: btnGlowShimmer 4s ease infinite !important;
    color: #FFFFFF !important;
    border: none;
    padding: 16px 24px;
    border-radius: 30px;
    font-family: 'Outfit', sans-serif;
    font-weight: 900;
    font-size: 1.15rem;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(214, 40, 57, 0.45);
    letter-spacing: 0.5px;
    transition: transform 0.2s, box-shadow 0.2s;
    margin-top: 14px;
  }
  .tg-add-to-cart-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(214, 40, 57, 0.55);
  }

  .tg-share-btn {
    background: rgba(255, 255, 255, 0.08) !important;
    color: var(--tg-text) !important;
    border: 1.5px solid var(--tg-border) !important;
    padding: 12px 20px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s;
  }
  .tg-share-btn:hover {
    background: rgba(255, 255, 255, 0.15) !important;
  }

  /* --- SPECTACULAR ANIMATIONS & AMBIENT AURA --- */
  @keyframes mediaAuraPulse {
    0%, 100% {
      box-shadow: 0 10px 35px var(--tg-shadow), 0 0 25px rgba(251, 191, 36, 0.25), inset 0 0 15px rgba(251, 191, 36, 0.15);
      border-color: rgba(251, 191, 36, 0.45);
    }
    50% {
      box-shadow: 0 16px 50px rgba(0, 0, 0, 0.7), 0 0 45px rgba(214, 40, 57, 0.45), 0 0 70px rgba(251, 191, 36, 0.35), inset 0 0 25px rgba(251, 191, 36, 0.3);
      border-color: #FBBF24;
    }
  }

  @keyframes cornerTwinkle {
    0% { opacity: 0.35; transform: scale(0.85); }
    100% { opacity: 1; transform: scale(1.22); filter: drop-shadow(0 0 8px #FBBF24); }
  }

  @keyframes badgeSweep {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes btnGlowShimmer {
    0% {
      background-position: 0% 50%;
      box-shadow: 0 4px 20px rgba(214, 40, 57, 0.45), 0 0 0 rgba(251, 191, 36, 0);
    }
    50% {
      background-position: 100% 50%;
      box-shadow: 0 8px 32px rgba(214, 40, 57, 0.75), 0 0 28px rgba(251, 191, 36, 0.55);
    }
    100% {
      background-position: 0% 50%;
      box-shadow: 0 4px 20px rgba(214, 40, 57, 0.45), 0 0 0 rgba(251, 191, 36, 0);
    }
  }

  @keyframes thumbGlowPulse {
    0%, 100% {
      box-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
      border-color: #FBBF24;
    }
    50% {
      box-shadow: 0 0 24px rgba(251, 191, 36, 0.95), 0 0 10px rgba(214, 40, 57, 0.65);
      border-color: #FFF8E7;
    }
  }

  @keyframes liveDotPulse {
    0%, 100% { opacity: 0.4; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.25); box-shadow: 0 0 14px #4ADE80; }
  }

  .tg-corner-filigree {
    position: absolute;
    width: 24px;
    height: 24px;
    pointer-events: none;
    z-index: 15;
    color: #FBBF24;
    font-size: 18px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: cornerTwinkle 3s ease-in-out infinite alternate;
  }
  .tg-corner-filigree.top-left { top: 10px; left: 10px; }
  .tg-corner-filigree.top-right { top: 10px; right: 10px; animation-delay: 0.75s; }
  .tg-corner-filigree.bottom-left { bottom: 10px; left: 10px; animation-delay: 1.5s; }
  .tg-corner-filigree.bottom-right { bottom: 10px; right: 10px; animation-delay: 2.25s; }

  .tg-spectacular-experience-banner {
    display: block;
    text-decoration: none;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    padding: 18px 22px;
    background: linear-gradient(135deg, rgba(158, 27, 50, 0.5), rgba(20, 12, 8, 0.9), rgba(251, 191, 36, 0.25));
    border: 2px solid var(--tg-gold);
    box-shadow: 0 6px 25px rgba(251, 191, 36, 0.3), inset 0 0 20px rgba(251, 191, 36, 0.18);
    margin: 20px auto;
    max-width: 650px;
    text-align: center;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .tg-spectacular-experience-banner:hover {
    transform: translateY(-3px) scale(1.015);
    box-shadow: 0 10px 36px rgba(251, 191, 36, 0.6), inset 0 0 30px rgba(251, 191, 36, 0.35);
    border-color: #FFF8E7;
  }
  .tg-exp-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #FBBF24;
    margin-bottom: 6px;
  }
  .tg-live-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #4ADE80;
    display: inline-block;
    box-shadow: 0 0 8px #4ADE80;
    animation: liveDotPulse 1.5s ease-in-out infinite;
  }
  .tg-exp-title {
    font-family: 'Cinzel', serif;
    font-size: 1.18rem;
    font-weight: 900;
    color: #FFF8E7;
    letter-spacing: 0.5px;
    margin-bottom: 5px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.6);
  }
  .tg-exp-subtitle {
    font-size: 0.9rem;
    color: #D1BDB0;
    line-height: 1.45;
  }

</style>

<div class="tg-product-wrapper">
  <div class="tg-container">

    <!-- Media Showcase (Dynamic Container: Enlarges for 9:16 Video, Shrinks for CR80 Card Art) -->
    <div id="tg-media-box" class="tg-media-box is-video">
      <!-- Slide 1: Video -->
      <div id="tg-slide-1" class="tg-slide active-slide">
        <video id="tg-hero-video" loop muted playsinline autoplay poster="{{ front_img_url }}">
          <source src="{{ video_url }}" type="video/mp4">
        </video>
        <button id="tg-sound-btn" class="tg-sound-toggle-btn" onclick="toggleTgSound()" title="Toggle Audio">
          🔇
        </button>
      </div>

      <!-- Slide 2: Digital Front Artwork -->
      <div id="tg-slide-2" class="tg-slide">
