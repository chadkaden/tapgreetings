<!-- Share Modal Popup -->
<div id="tg-share-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 99999; justify-content: center; align-items: center; padding: 16px; backdrop-filter: blur(8px);">
  <div style="background: #1E130D; border: 2px solid #FBBF24; border-radius: 20px; padding: 28px 24px; max-width: 420px; width: 100%; text-align: center; color: #FFF; box-shadow: 0 10px 40px rgba(0,0,0,0.6); position: relative;">
    <button onclick="closeTgShareModal()" style="position: absolute; top: 12px; right: 14px; background: transparent; border: none; color: #FBBF24; font-size: 1.4rem; cursor: pointer; font-weight: 800;">✕</button>

    <h3 style="font-family: 'Outfit', sans-serif; color: #FBBF24; margin: 0 0 8px 0; font-size: 1.35rem;">
      ✨ Share TapGreetings Keepsake
    </h3>
    <p style="font-size: 0.9rem; color: #D1BDB0; margin-bottom: 16px;">
      Direct link to stream the holiday video experience:
    </p>

    <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(251,191,36,0.3); border-radius: 12px; padding: 10px 14px; margin-bottom: 18px; word-break: break-all; font-size: 0.85rem; color: #FFF8E7;" id="tg-share-url-text">
      {{ web_portal_url }}
    </div>

    <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
      <a href="{{ web_portal_url }}" target="_blank" rel="noopener noreferrer" style="flex: 1; min-width: 140px; background: linear-gradient(90deg, #D62839, #E65100); color: #FFF; text-decoration: none; padding: 12px 16px; border-radius: 16px; font-weight: 700; font-size: 0.9rem; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
        ↗ Open Experience
      </a>
      <button onclick="copyTgShareUrl()" style="flex: 1; min-width: 120px; background: rgba(255,255,255,0.1); border: 1px solid #FBBF24; color: #FBBF24; padding: 12px 16px; border-radius: 16px; font-weight: 700; font-size: 0.9rem; cursor: pointer;">
        📋 Copy Link
      </button>
    </div>
  </div>
</div>

<script>
  // Dynamic Slide Switcher (Enlarges container for Video, Shrinks for CR80 Card Art)
  function switchTgSlide(index) {
    var mediaBox = document.getElementById('tg-media-box');
    var slides = document.querySelectorAll('.tg-slide');
    var thumbs = document.querySelectorAll('.tg-thumb-btn');

    if (mediaBox) {
      if (index === 1 || index === 4) {
        mediaBox.classList.remove('is-card');
        mediaBox.classList.add('is-video');
      } else {
        mediaBox.classList.remove('is-video');
        mediaBox.classList.add('is-card');
      }
    }

    slides.forEach(function(s, i) {
      if (i === (index - 1)) {
        s.classList.add('active-slide');
      } else {
        s.classList.remove('active-slide');
      }
    });

    thumbs.forEach(function(t, i) {
      if (i === (index - 1)) {
        t.classList.add('active');
      } else {
        t.classList.remove('active');
      }
    });

    var heroVideo = document.getElementById('tg-hero-video');
    var tapVideo = document.getElementById('tg-tap-video');

    if (heroVideo) {
      if (index === 1) { heroVideo.play().catch(function(){}); } else { heroVideo.pause(); }
    }
    if (tapVideo) {
      if (index === 4) { tapVideo.play().catch(function(){}); } else { tapVideo.pause(); }
    }
  }

  // Audio Toggle with Sound Persistence
  function toggleTgSound() {
    var video = document.getElementById('tg-hero-video');
    var btn = document.getElementById('tg-sound-btn');
    if (!video) return;

    if (video.muted) {
      video.muted = false;
      localStorage.setItem('tg_sound', 'unmuted');
      if (btn) btn.textContent = '🔊';
    } else {
      video.muted = true;
      localStorage.setItem('tg_sound', 'muted');
      if (btn) btn.textContent = '🔇';
    }
  }

  // Check persisted sound preference
  (function initTgSound() {
    var saved = localStorage.getItem('tg_sound');
    var video = document.getElementById('tg-hero-video');
    var btn = document.getElementById('tg-sound-btn');
    if (saved === 'unmuted' && video) {
      video.muted = false;
      if (btn) btn.textContent = '🔊';
    }
  })();

  // Share Modal Functions
  function openTgShareModal() {
    var modal = document.getElementById('tg-share-modal');
    if (modal) modal.style.display = 'flex';
  }
  function closeTgShareModal() {
    var modal = document.getElementById('tg-share-modal');
    if (modal) modal.style.display = 'none';
  }
  function copyTgShareUrl() {
    var url = '{{ web_portal_url }}';
    if (navigator.clipboard) {
      navigator.clipboard.writeText(url).then(function() {
        alert('Keepsake experience link copied to clipboard!');
      });
    } else {
      prompt('Copy this link:', url);
    }
  }
</script>
