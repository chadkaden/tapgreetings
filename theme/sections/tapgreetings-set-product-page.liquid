{% comment %}
  TapGreetings Happy Holidays Series 1: Master Collection & Box Set Product Page
  - Centered unexpanded media viewport (max-width 420px, 9:16 aspect ratio) matching Pink-O-Ween
  - 4-Slide Multimedia Showcase: Card Video, Front Art, Back Art, and Mobile NFC Tap Demo (Ghost Tap)
  - Interactive Variant Selection Thumbnail Reel (Box Set + 16 Cards)
  - Dynamic Video & Image Switching upon Variant Selection
  - Dual Add-to-Cart Forms (Below Media & In Purchase Panel)
  - Full Dark Mode & Light Mode High-Contrast Support
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">

{% assign tap_demo_url = 'card_01_tap.mp4' | asset_url %}

<style>
  .tg-set-wrapper {
    --tg-bg: #140C08;
    --tg-surface: #1E130D;
    --tg-surface-card: rgba(255, 255, 255, 0.05);
    --tg-border: rgba(251, 191, 36, 0.28);
    --tg-border-active: #FBBF24;
    --tg-text: #F5EBE1;
    --tg-text-muted: #D1BDB0;
    --tg-heading: #FFF8E7;
    --tg-gold: #FBBF24;
    --tg-gold-glow: rgba(251, 191, 36, 0.45);
    --tg-red: #D62839;
    --tg-red-dark: #9E1B32;
    --tg-shadow: rgba(0, 0, 0, 0.5);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    padding: 16px 16px 48px;
    background: var(--tg-bg) !important;
    color: var(--tg-text) !important;
    transition: background-color 0.3s ease, color 0.3s ease;
    box-sizing: border-box;
  }

  body.tt-light-mode .tg-set-wrapper {
    --tg-bg: #FFFDF7;
    --tg-surface: #FDF6EE;
    --tg-surface-card: #FFFFFF;
    --tg-border: #E8D5C4;
    --tg-border-active: #9E1B32;
    --tg-text: #2D1A10;
    --tg-text-muted: #6B4226;
    --tg-heading: #9E1B32;
    --tg-gold: #B45309;
    --tg-gold-glow: rgba(180, 83, 9, 0.2);
    --tg-red: #D62839;
    --tg-red-dark: #9E1B32;
    --tg-shadow: rgba(61, 35, 20, 0.08);
    background: var(--tg-bg) !important;
    color: var(--tg-text) !important;
  }

  .tg-set-wrapper * {
    box-sizing: border-box;
  }

  .tg-set-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Top Navigation */
  .tg-set-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding: 4px 0;
  }
  .tg-set-nav a {
    color: var(--tg-gold) !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: opacity 0.2s;
  }
  .tg-set-nav a:hover {
    opacity: 0.85;
  }

  /* Header Badges */
  .tg-set-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(90deg, #9E1B32, #D62839) !important;
    color: #FFFFFF !important;
    padding: 6px 18px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    box-shadow: 0 4px 15px rgba(214, 40, 57, 0.35);
    margin-bottom: 10px;
  }

  .tg-set-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.85rem;
    font-weight: 900;
    color: var(--tg-heading) !important;
    margin: 0 0 8px 0;
    line-height: 1.25;
  }

  .tg-set-subtitle {
    font-size: 0.95rem;
    color: var(--tg-gold);
    font-weight: 600;
    margin-bottom: 20px;
  }

  /* Centered Multimedia Section - DOES NOT EXPAND (Matches Pink-O-Ween) */
  .tg-media-section {
    max-width: 720px;
    margin: 0 auto 24px;
    background: var(--tg-surface-card);
    border: 1.5px solid var(--tg-border);
    border-radius: 24px;
    padding: 16px;
    box-shadow: 0 4px 20px var(--tg-shadow);
  }

  /* Centered Media Viewport (9:16 Aspect Ratio) */
  .tg-media-viewport {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin: 0 auto 16px;
    aspect-ratio: 9 / 16;
    border-radius: 20px;
    overflow: hidden;
    background: #000000;
    border: 2.5px solid var(--tg-border-active);
    box-shadow: 0 10px 35px var(--tg-shadow);
  }

  .tg-slide {
    width: 100%;
    height: 100%;
    display: none;
    position: relative;
  }
  .tg-slide.active-slide {
    display: block;
  }
  .tg-slide video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .tg-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    background: #140C08;
  }

  /* Sound Toggle Button */
  .tg-sound-btn {
    position: absolute;
    bottom: 14px;
    right: 14px;
    z-index: 20;
    background: rgba(20, 12, 8, 0.85);
    border: 1.5px solid var(--tg-gold);
    color: var(--tg-gold);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 1.15rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
    transition: transform 0.2s, background 0.2s;
  }
  .tg-sound-btn:hover {
    transform: scale(1.08);
    background: rgba(20, 12, 8, 0.98);
  }

  /* 4-Thumbnail Multimedia Selector Bar */
  .tg-media-thumbs {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .tg-media-thumb-btn {
    flex: 0 0 74px;
    width: 74px;
    height: 74px;
    border-radius: 14px;
    background: var(--tg-surface);
    border: 2px solid var(--tg-border);
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--tg-text);
  }
  .tg-media-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tg-media-thumb-btn.active {
    border-color: var(--tg-border-active) !important;
    box-shadow: 0 0 16px var(--tg-gold-glow) !important;
    transform: translateY(-2px);
  }
  .tg-media-thumb-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--tg-gold);
    margin-top: 2px;
  }

  .tg-btn-atc {
    width: 100%;
    background: linear-gradient(90deg, #9E1B32, #D62839);
    color: #FFFFFF !important;
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    padding: 16px 20px;
    border: none;
    border-radius: 16px;
    cursor: pointer;
    box-shadow: 0 6px 22px rgba(214, 40, 57, 0.45);
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .tg-btn-atc:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(214, 40, 57, 0.6);
  }

  /* Variant Selection Thumbnail Reel (Pink-O-Ween Style) */
  .tg-var-section {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1.5px solid var(--tg-border);
  }
  .tg-var-scroll {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 8px 4px;
    scrollbar-width: thin;
    scrollbar-color: var(--tg-gold) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .tg-var-btn {
    flex: 0 0 78px;
    width: 78px;
    border-radius: 14px;
    background: var(--tg-surface);
    border: 2px solid var(--tg-border);
    cursor: pointer;
    overflow: hidden;
    padding: 4px;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .tg-var-btn img {
    width: 100%;
    aspect-ratio: 54/86;
    object-fit: cover;
    border-radius: 10px;
  }
  .tg-var-btn.active {
    border-color: var(--tg-border-active) !important;
    box-shadow: 0 0 16px var(--tg-gold-glow) !important;
    transform: translateY(-2px);
    background: rgba(251, 191, 36, 0.12) !important;
  }
  .tg-var-btn-code {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--tg-gold);
    margin-top: 4px;
  }
  .tg-var-btn-name {
    font-size: 0.68rem;
    color: var(--tg-text);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }

  /* Pricing Box */
  .tg-price-box {
    margin: 18px 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .tg-current-price {
    font-family: 'Outfit', sans-serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--tg-gold);
  }
  .tg-compare-price {
    font-size: 1.25rem;
    text-decoration: line-through;
    color: var(--tg-text-muted);
  }
  .tg-savings-pill {
    background: linear-gradient(90deg, #9E1B32, #D62839);
    color: #FFF;
    font-weight: 800;
    font-size: 0.8rem;
    padding: 4px 12px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Collapsible Accordions */
  .tg-details {
    background: var(--tg-surface-card) !important;
    border: 1.5px solid var(--tg-border) !important;
    border-radius: 20px;
    padding: 16px 20px;
    margin-bottom: 20px;
    box-shadow: 0 4px 16px var(--tg-shadow);
  }
  .tg-summary {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--tg-heading) !important;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }
  .tg-details[open] .tg-icon {
    transform: rotate(180deg);
  }
  .tg-icon {
    transition: transform 0.2s ease;
    color: var(--tg-gold);
    font-size: 0.9rem;
  }
</style>

<div class="tg-set-wrapper">
  <div class="tg-set-container">

    <!-- Top Navigation -->
    <div class="tg-set-nav">
      <a href="/collections/tapgreetings-series-1">
        &larr; Back to Series 1 Collection
      </a>
      <a href="https://tapgreetings.com/#collection" target="_blank">
        🎬 View All 21 Cards on TapGreetings ↗
      </a>
    </div>

    <!-- Header Section -->
    <div style="text-align: center; margin-bottom: 20px;">
      <div class="tg-set-badge">
        ✦ HAPPY HOLIDAYS SERIES 1 &bull; MASTER COLLECTION ✦
      </div>
      <h1 class="tg-set-title">
        Happy Holidays Series 1: Master Collector Box Set
      </h1>
      <div class="tg-set-subtitle">
        Choose the Complete 16-Card Box Set or Select Any Individual Card Keepsake
      </div>
    </div>

    <!-- 2. CARD MULTIMEDIA & ARTWORK SHOWCASE (Centered, uncropped 9:16, matches Pink-O-Ween) -->
    <div class="tg-media-section">
      
      <!-- Main Media Viewport -->
      <div class="tg-media-viewport" id="tg-media-box">
        
        <!-- Slide 1: Video -->
        <div id="tg-slide-1" class="tg-slide active-slide">
          <video id="tg-card-video" loop muted playsinline autoplay poster="{{ product.images[1] | image_url: width: 800 }}">
            <source id="tg-video-source" src="{{ 'tapgreeting_001.mp4' | asset_url }}" type="video/mp4">
          </video>
          <button id="tg-sound-btn" onclick="toggleSound()" class="tg-sound-btn" title="Toggle Sound">
            🔇
          </button>
        </div>

        <!-- Slide 2: Front Artwork -->
        <div id="tg-slide-2" class="tg-slide">
          <img id="tg-front-img" src="{{ product.images[0] | image_url: width: 1000 }}" alt="Front Artwork">
        </div>

        <!-- Slide 3: Back Specs / Design -->
        <div id="tg-slide-3" class="tg-slide">
          <img id="tg-back-img" src="{{ '001-back.jpg' | asset_url }}" alt="Back Collector Design">
        </div>

        <!-- Slide 4: Mobile NFC Tap Demo (Ghost Tap Feature) -->
        <div id="tg-slide-4" class="tg-slide">
          <video id="tg-tap-video" loop muted playsinline poster="{{ product.images[1] | image_url: width: 800 }}">
            <source src="{{ tap_demo_url }}" type="video/mp4">
          </video>
        </div>

      </div>

      <!-- Touch Swipe Hint -->
      <div style="text-align: center; font-size: 0.75rem; color: var(--tg-gold); margin-top: -6px; margin-bottom: 12px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 6px;">
        <span>&#8644;</span> <span>Swipe multimedia left/right for previous/next slide</span>
      </div>

      <!-- 4-Thumbnail Multimedia Selector Bar -->
      <div class="tg-media-thumbs">
        <button type="button" id="tg-media-btn-1" onclick="switchMediaSlide(1)" class="tg-media-thumb-btn active" title="Stop-Motion Video">
          <div style="font-size: 1.2rem;">🎬</div>
          <div class="tg-media-thumb-label">Video</div>
        </button>

        <button type="button" id="tg-media-btn-2" onclick="switchMediaSlide(2)" class="tg-media-thumb-btn" title="Front Artwork">
          <div style="font-size: 1.2rem;">🎴</div>
          <div class="tg-media-thumb-label">Front</div>
        </button>

        <button type="button" id="tg-media-btn-3" onclick="switchMediaSlide(3)" class="tg-media-thumb-btn" title="Back Collector Design">
          <div style="font-size: 1.2rem;">📜</div>
          <div class="tg-media-thumb-label">Back</div>
        </button>

        <button type="button" id="tg-media-btn-4" onclick="switchMediaSlide(4)" class="tg-media-thumb-btn" title="Mobile NFC Tap Demo">
          <div style="font-size: 1.2rem;">📱</div>
          <div class="tg-media-thumb-label">Tap Demo</div>
        </button>
      </div>

      

      <!-- Variant Selection Thumbnail Reel (Pink-O-Ween Style) -->
      <div class="tg-var-section">
        

        <div class="tg-var-scroll" id="tg-var-scroll">
          {% for v in product.variants %}
            {% assign v_code = 'box' %}
            {% if v.title contains '#' %}
              {% assign parts = v.title | split: '#' %}
              {% assign subparts = parts[1] | split: ' ' %}
              {% assign v_code = subparts[0] %}
            {% endif %}

            {% assign v_img_idx = forloop.index0 %}
            {% if v_img_idx >= product.images.size %}
              {% assign v_img_idx = 0 %}
            {% endif %}

            <button type="button" id="tg-var-thumb-{{ v.id }}" onclick="selectVariantById({{ v.id }})" class="tg-var-btn {% if v.id == product.selected_or_first_available_variant.id %}active{% endif %}" title="{{ v.title }}">
              <img src="{{ product.images[v_img_idx] | image_url: width: 140 }}" alt="{{ v.title }}">
              <div class="tg-var-btn-code">{% if v_code == 'box' %}BOX SET{% else %}#{{ v_code }}{% endif %}</div>
              <div class="tg-var-btn-name">{{ v.title | split: ' (' | first | remove: 'Card #' }}</div>
            </button>
          {% endfor %}
        </div>
      </div>

    </div>

    <!-- 3. Form & Purchase Details Panel -->
    <div style="max-width: 720px; margin: 0 auto 28px;">
      {% form 'product', product, id: 'tg-set-form' %}
        
        <input type="hidden" name="id" id="tg-selected-variant-id" value="{{ product.selected_or_first_available_variant.id }}">

        <label style="font-weight: 800; font-size: 0.95rem; color: var(--tg-gold); display: block; margin-bottom: 8px;">
          🎁 Card Selection Dropdown:
        </label>

        <!-- Dropdown Selection (Synced with Variant Reel) -->
        <div style="margin-bottom: 16px;">
          <select id="tg-variant-select" onchange="selectVariantById(this.value)" style="width: 100%; background: var(--tg-surface); color: var(--tg-text); border: 2px solid var(--tg-border); border-radius: 14px; padding: 14px 16px; font-size: 1rem; font-weight: 700; cursor: pointer; outline: none;">
            {% for v in product.variants %}
              <option value="{{ v.id }}" data-price="{{ v.price | money }}" data-compare="{{ v.compare_at_price | money }}" data-raw-price="{{ v.price }}" data-raw-compare="{{ v.compare_at_price }}" data-sku="{{ v.sku }}" {% if v.id == product.selected_or_first_available_variant.id %}selected{% endif %}>
                {{ v.title }} &bull; {{ v.price | money }}
              </option>
            {% endfor %}
          </select>
        </div>

        <!-- Live Price & Savings Display -->
        <div class="tg-price-box">
          <span id="tg-live-price" class="tg-current-price">
            {{ product.selected_or_first_available_variant.price | money }}
          </span>
          <span id="tg-live-compare" class="tg-compare-price" style="{% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}display:none;{% endunless %}">
            {{ product.selected_or_first_available_variant.compare_at_price | money }}
          </span>
          <span id="tg-savings-badge" class="tg-savings-pill" style="{% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}display:none;{% endunless %}">
            Save $40.84 (17% OFF)
          </span>
        </div>

        <!-- Quantity & Secondary Add to Cart -->
        <div style="display: flex; gap: 12px; margin-bottom: 24px; align-items: center;">
          <div style="background: var(--tg-surface-card); border: 2px solid var(--tg-border); border-radius: 14px; padding: 0 12px; display: flex; align-items: center; height: 56px;">
            <label for="Quantity" style="font-size: 0.8rem; font-weight: 700; color: var(--tg-text-muted); margin-right: 8px;">QTY:</label>
            <input type="number" id="Quantity" name="quantity" value="1" min="1" style="width: 44px; background: transparent; border: none; color: var(--tg-text); font-size: 1.1rem; font-weight: 800; text-align: center; outline: none;">
          </div>

          <button type="submit" name="add" class="tg-btn-atc" style="flex: 1;">
            <span>🛒 Add to Cart</span>
            <span>&bull;</span>
            <span id="tg-btn-price-bottom">{{ product.selected_or_first_available_variant.price | money }}</span>
          </button>
        </div>

      {% endform %}
    </div>

    <!-- 4. Detailed Accordions with Enhanced Reprogrammability Lore -->
    <div style="max-width: 720px; margin: 0 auto;">
      
      <!-- 1. Lore & Description Accordion -->
      <details open class="tg-details">
        <summary class="tg-summary">
          <span>✨ Character Lore &amp; Keepsake Description</span>
          <span class="tg-icon">&#9660;</span>
        </summary>
        <div style="padding-top: 16px;">
          
          <!-- Highlighted Smart NFC Callout -->
          <div style="background: rgba(251, 191, 36, 0.08); border: 1.5px solid var(--tg-gold); border-radius: 16px; padding: 16px; margin-bottom: 18px;">
            <h4 style="margin: 0 0 8px 0; color: var(--tg-gold); font-size: 1.05rem; font-weight: 800; display: flex; align-items: center; gap: 8px;">
              📱 Tap to Play Video &bull; Reprogram to Your Own Message Anytime!
            </h4>
            <p style="margin: 0 0 10px 0; font-size: 0.92rem; line-height: 1.6; color: var(--tg-text);">
              <strong>Tap this card</strong> against the top edge of your iPhone or Android to instantly launch the exclusive holiday video and voice greeting—zero app download required.
            </p>
            <p style="margin: 0; font-size: 0.88rem; line-height: 1.5; color: var(--tg-text-muted);">
              <strong>⚡ Rewritable NTAG215 Microchip:</strong> Want to personalize this card? It can easily be reprogrammed to link to your own custom family holiday video, voice note, photos, or personalized greeting anytime using our free Web NFC Tool at <a href="https://shop.tapthingy.com/pages/tap-thingy-tools-nfc-reprogram-webtool-and-guide" target="_blank" style="color: var(--tg-gold); font-weight: 700; text-decoration: underline;">shop.tapthingy.com/pages/tap-thingy-tools-nfc-reprogram-webtool-and-guide</a> (or the NFC Tools app on iPhone &amp; Android).
            </p>
          </div>

          <div style="font-size: 0.92rem; line-height: 1.7; color: var(--tg-text-muted);">
            {{ product.description }}
          </div>
        </div>
      </details>

      <!-- 2. Technical Specs Accordion -->
      <details open class="tg-details">
        <summary class="tg-summary">
          <span>🛡️ Hardware Specs &amp; NFC Technology</span>
          <span class="tg-icon">&#9660;</span>
        </summary>
        <div style="padding-top: 14px;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.92rem; text-align: left;">
            <tbody>
              <tr style="border-bottom: 1px solid var(--tg-border);">
                <td style="padding: 10px 0; font-weight: 700; color: var(--tg-gold); width: 40%;">Smartphone Compatibility:</td>
                <td style="padding: 10px 0; color: var(--tg-text);">100% Compatible with iPhone (XS through 16 Pro) &amp; all NFC-enabled Android devices (Zero app required).</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--tg-border);">
                <td style="padding: 10px 0; font-weight: 700; color: var(--tg-gold);">Card Format &amp; Specs:</td>
                <td style="padding: 10px 0; color: var(--tg-text);">Standard CR80 Credit Card Proportions (85.6mm &times; 53.98mm &times; 0.76mm / 30 mil).</td>
              </tr>
              
              <tr>
                <td style="padding: 10px 0; font-weight: 700; color: var(--tg-gold);">Web Video Portal:</td>
                <td style="padding: 10px 0; color: var(--tg-text);">
                  <a href="https://tapgreetings.com" target="_blank" style="color: var(--tg-gold); font-weight: 700; text-decoration: underline;">
                    https://tapgreetings.com
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </details>

    </div>

  </div>
</div>

<script>
  // Variant metadata map for dynamic media switching
  var variantMeta = {
    "68065708998978": {
      code: "001",
      isBox: true,
      front: "{{ product.images[0] | image_url: width: 1000 }}",
      back: "{{ '001-back.jpg' | asset_url }}",
      video: "{{ 'tapgreeting_001.mp4' | asset_url }}"
    },
    "68065709031746": {
