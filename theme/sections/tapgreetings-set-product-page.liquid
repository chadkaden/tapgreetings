<style>
  .tg-set-wrapper {
    --tg-bg: #140C08;
    --tg-surface: #1E130D;
    --tg-surface-card: rgba(255, 255, 255, 0.05);
    --tg-border: rgba(251, 191, 36, 0.28);
    --tg-border-active: #FBBF24;
    --tg-text: #F5EBE1;
    --tg-text-muted: #D1BDB0;
    --tg-heading: #FFF8E7;
    --tg-gold: #FBBF24;
    --tg-gold-glow: rgba(251, 191, 36, 0.45);
    --tg-red: #D62839;
    --tg-red-dark: #9E1B32;
    --tg-shadow: rgba(0, 0, 0, 0.5);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    padding: 16px 16px 48px;
    background: var(--tg-bg) !important;
    color: var(--tg-text) !important;
    transition: background-color 0.3s ease, color 0.3s ease;
    box-sizing: border-box;
  }

  body.tt-light-mode .tg-set-wrapper {
    --tg-bg: #FFFDF7;
    --tg-surface: #FDF6EE;
    --tg-surface-card: #FFFFFF;
    --tg-border: #E8D5C4;
    --tg-border-active: #9E1B32;
    --tg-text: #2D1A10;
    --tg-text-muted: #6B4226;
    --tg-heading: #9E1B32;
    --tg-gold: #B45309;
    --tg-gold-glow: rgba(180, 83, 9, 0.2);
    --tg-red: #D62839;
    --tg-red-dark: #9E1B32;
    --tg-shadow: rgba(61, 35, 20, 0.08);
    background: var(--tg-bg) !important;
    color: var(--tg-text) !important;
  }

  .tg-set-wrapper * {
    box-sizing: border-box;
  }

  .tg-set-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Top Navigation */
  .tg-set-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding: 4px 0;
  }
  .tg-set-nav a {
    color: var(--tg-gold) !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: opacity 0.2s;
  }
  .tg-set-nav a:hover {
    opacity: 0.85;
  }

  /* Header Badges */
  .tg-set-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #9E1B32, #D62839, #E65100, #FBBF24, #9E1B32) !important;
    background-size: 300% 300% !important;
    animation: badgeSweep 6s ease infinite !important;
    color: #FFFFFF !important;
    padding: 7px 20px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    box-shadow: 0 4px 18px rgba(214, 40, 57, 0.45);
    margin-bottom: 10px;
  }

  .tg-set-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.85rem;
    font-weight: 900;
    color: var(--tg-heading) !important;
    margin: 0 0 8px 0;
    line-height: 1.25;
  }

  .tg-set-subtitle {
    font-size: 0.95rem;
    color: var(--tg-gold);
    font-weight: 600;
    margin-bottom: 20px;
  }

  /* Centered Multimedia Section - DOES NOT EXPAND (Matches Pink-O-Ween) */
  .tg-media-section {
    max-width: 720px;
    margin: 0 auto 24px;
    background: var(--tg-surface-card);
    border: 1.5px solid var(--tg-border);
    border-radius: 24px;
    padding: 16px;
    box-shadow: 0 4px 20px var(--tg-shadow);
  }

  /* Centered Media Viewport (9:16 Aspect Ratio) */
  .tg-media-viewport {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin: 0 auto 16px;
    aspect-ratio: 9 / 16;
    border-radius: 20px;
    overflow: hidden;
    background: #000000;
    border: 2.5px solid var(--tg-border-active);
    box-shadow: 0 10px 35px var(--tg-shadow);
    animation: mediaAuraPulse 4s ease-in-out infinite;
  }

  .tg-slide {
    width: 100%;
    height: 100%;
    display: none;
    position: relative;
  }
  .tg-slide.active-slide {
    display: block;
  }
  .tg-slide video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .tg-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    background: #140C08;
  }

  /* Sound Toggle Button */
  .tg-sound-btn {
    position: absolute;
    bottom: 14px;
    right: 14px;
    z-index: 20;
    background: rgba(20, 12, 8, 0.85);
    border: 1.5px solid var(--tg-gold);
    color: var(--tg-gold);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 1.15rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
    transition: transform 0.2s, background 0.2s;
  }
  .tg-sound-btn:hover {
    transform: scale(1.08);
    background: rgba(20, 12, 8, 0.98);
  }

  /* 4-Thumbnail Multimedia Selector Bar (Strict One-Line Horizontal Scroll) */
  .tg-media-thumbs {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    justify-content: flex-start;
    gap: 10px;
    padding: 6px 4px 12px 4px;
    margin-bottom: 18px;
    scrollbar-width: thin;
    scrollbar-color: var(--tg-gold) transparent;
    -webkit-overflow-scrolling: touch;
  }
  @media (min-width: 440px) {
    .tg-media-thumbs {
      justify-content: center;
    }
  }
  .tg-media-thumb-btn {
    flex: 0 0 80px;
    width: 80px;
    height: 74px;
    border-radius: 14px;
    background: var(--tg-surface);
    border: 2px solid var(--tg-border);
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--tg-text);
    flex-shrink: 0;
  }
  .tg-media-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tg-media-thumb-btn.active {
    border-color: var(--tg-border-active) !important;
    animation: thumbGlowPulse 2.5s ease-in-out infinite alternate !important;
    transform: translateY(-2px);
  }
  .tg-media-thumb-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--tg-gold);
    margin-top: 2px;
    white-space: nowrap;
  }

  .tg-btn-atc {
    width: 100%;
    background: linear-gradient(135deg, #9E1B32, #D62839, #E65100, #FBBF24, #D62839) !important;
    background-size: 250% 250% !important;
    animation: btnGlowShimmer 4s ease infinite !important;
    color: #FFFFFF !important;
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    padding: 16px 20px;
    border: none;
    border-radius: 16px;
    cursor: pointer;
    box-shadow: 0 6px 22px rgba(214, 40, 57, 0.45);
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .tg-btn-atc:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(214, 40, 57, 0.6);
  }

  /* Variant Selection Thumbnail Reel (Pink-O-Ween Style) */
  .tg-var-section {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1.5px solid var(--tg-border);
  }
  .tg-var-scroll {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 8px 4px;
    scrollbar-width: thin;
    scrollbar-color: var(--tg-gold) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .tg-var-btn {
    flex: 0 0 78px;
    width: 78px;
    border-radius: 14px;
    background: var(--tg-surface);
    border: 2px solid var(--tg-border);
    cursor: pointer;
    overflow: hidden;
    padding: 4px;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .tg-var-btn img {
    width: 100%;
    aspect-ratio: 54/86;
    object-fit: cover;
    border-radius: 10px;
  }
  .tg-var-btn.active {
    border-color: var(--tg-border-active) !important;
    box-shadow: 0 0 16px var(--tg-gold-glow) !important;
    transform: translateY(-2px);
    background: rgba(251, 191, 36, 0.12) !important;
  }
  .tg-var-btn-code {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--tg-gold);
    margin-top: 4px;
  }
  .tg-var-btn-name {
    font-size: 0.68rem;
    color: var(--tg-text);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }

  /* Pricing Box */
  .tg-price-box {
    margin: 18px 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .tg-current-price {
    font-family: 'Outfit', sans-serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--tg-gold);
  }
  .tg-compare-price {
    font-size: 1.25rem;
    text-decoration: line-through;
    color: var(--tg-text-muted);
  }
  .tg-savings-pill {
    background: linear-gradient(90deg, #9E1B32, #D62839);
    color: #FFF;
    font-weight: 800;
    font-size: 0.8rem;
    padding: 4px 12px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Collapsible Accordions */
  .tg-details {
    background: var(--tg-surface-card) !important;
    border: 1.5px solid var(--tg-border) !important;
    border-radius: 20px;
    padding: 16px 20px;
    margin-bottom: 20px;
    box-shadow: 0 4px 16px var(--tg-shadow);
  }
  .tg-summary {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--tg-heading) !important;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }
  .tg-details[open] .tg-icon {
    transform: rotate(180deg);
  }
  .tg-icon {
    transition: transform 0.2s ease;
    color: var(--tg-gold);
    font-size: 0.9rem;
  }

  /* --- SPECTACULAR ANIMATIONS & AMBIENT AURA --- */
  @keyframes mediaAuraPulse {
    0%, 100% {
      box-shadow: 0 10px 35px var(--tg-shadow), 0 0 25px rgba(251, 191, 36, 0.25), inset 0 0 15px rgba(251, 191, 36, 0.15);
      border-color: rgba(251, 191, 36, 0.45);
    }
    50% {
      box-shadow: 0 16px 50px rgba(0, 0, 0, 0.7), 0 0 45px rgba(214, 40, 57, 0.45), 0 0 70px rgba(251, 191, 36, 0.35), inset 0 0 25px rgba(251, 191, 36, 0.3);
      border-color: #FBBF24;
    }
  }

  @keyframes cornerTwinkle {
    0% { opacity: 0.35; transform: scale(0.85); }
    100% { opacity: 1; transform: scale(1.22); filter: drop-shadow(0 0 8px #FBBF24); }
  }

  @keyframes badgeSweep {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes btnGlowShimmer {
    0% {
      background-position: 0% 50%;
      box-shadow: 0 4px 20px rgba(214, 40, 57, 0.45), 0 0 0 rgba(251, 191, 36, 0);
    }
    50% {
      background-position: 100% 50%;
      box-shadow: 0 8px 32px rgba(214, 40, 57, 0.75), 0 0 28px rgba(251, 191, 36, 0.55);
    }
    100% {
      background-position: 0% 50%;
      box-shadow: 0 4px 20px rgba(214, 40, 57, 0.45), 0 0 0 rgba(251, 191, 36, 0);
    }
  }

  @keyframes thumbGlowPulse {
    0%, 100% {
      box-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
      border-color: #FBBF24;
    }
    50% {
      box-shadow: 0 0 24px rgba(251, 191, 36, 0.95), 0 0 10px rgba(214, 40, 57, 0.65);
      border-color: #FFF8E7;
    }
  }

  @keyframes liveDotPulse {
    0%, 100% { opacity: 0.4; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.25); box-shadow: 0 0 14px #4ADE80; }
  }

  .tg-corner-filigree {
    position: absolute;
    width: 24px;
    height: 24px;
    pointer-events: none;
    z-index: 15;
    color: #FBBF24;
    font-size: 18px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: cornerTwinkle 3s ease-in-out infinite alternate;
  }
  .tg-corner-filigree.top-left { top: 10px; left: 10px; }
  .tg-corner-filigree.top-right { top: 10px; right: 10px; animation-delay: 0.75s; }
  .tg-corner-filigree.bottom-left { bottom: 10px; left: 10px; animation-delay: 1.5s; }
  .tg-corner-filigree.bottom-right { bottom: 10px; right: 10px; animation-delay: 2.25s; }

  .tg-spectacular-experience-banner {
    display: block;
    text-decoration: none;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    padding: 18px 22px;
    background: linear-gradient(135deg, rgba(158, 27, 50, 0.5), rgba(20, 12, 8, 0.9), rgba(251, 191, 36, 0.25));
    border: 2px solid var(--tg-gold);
    box-shadow: 0 6px 25px rgba(251, 191, 36, 0.3), inset 0 0 20px rgba(251, 191, 36, 0.18);
    margin: 20px auto;
    max-width: 650px;
    text-align: center;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .tg-spectacular-experience-banner:hover {
    transform: translateY(-3px) scale(1.015);
    box-shadow: 0 10px 36px rgba(251, 191, 36, 0.6), inset 0 0 30px rgba(251, 191, 36, 0.35);
    border-color: #FFF8E7;
  }
  .tg-exp-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #FBBF24;
    margin-bottom: 6px;
  }
  .tg-live-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #4ADE80;
    display: inline-block;
    box-shadow: 0 0 8px #4ADE80;
    animation: liveDotPulse 1.5s ease-in-out infinite;
  }
  .tg-exp-title {
    font-family: 'Cinzel', serif;
    font-size: 1.18rem;
    font-weight: 900;
    color: #FFF8E7;
    letter-spacing: 0.5px;
    margin-bottom: 5px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.6);
  }
  .tg-exp-subtitle {
    font-size: 0.9rem;
    color: #D1BDB0;
    line-height: 1.45;
  }


  /* --- LIVELY THEMED CHARACTER SHOWCASE (MATCHES SHOP.TAPTHINGY.COM/PAGES) --- */
  .tghh-experience-wrap {
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: #140C08 !important;
    color: #FFF8E7 !important;
    border-radius: 28px !important;
    padding: 28px 20px 40px !important;
    max-width: 680px;
    margin: 24px auto 36px;
    box-shadow: 0 12px 50px rgba(0,0,0,0.7), 0 0 35px rgba(251,191,36,0.18) !important;
    border: 2px solid rgba(251,191,36,0.4) !important;
    position: relative;
    overflow: hidden;
  }
  .tghh-corner {
    position: absolute;
    color: #FBBF24;
    font-size: 14px;
    opacity: 0.85;
    text-shadow: 0 0 8px rgba(251,191,36,0.7);
    user-select: none;
    animation: cornerTwinkle 3s ease-in-out infinite alternate;
  }
  .tghh-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #9E1B32, #D62839, #E65100, #FBBF24, #9E1B32) !important;
    background-size: 300% 300% !important;
    animation: badgeSweep 6s ease infinite !important;
    color: #FFFFFF !important;
    padding: 7px 20px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    box-shadow: 0 4px 18px rgba(214,40,57,0.45);
    margin-bottom: 12px;
  }
  .tghh-dyn-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.3rem;
    font-weight: 900;
    color: #FFFFFF !important;
    margin: 4px 0 6px;
    line-height: 1.2;
    text-shadow: 0 2px 12px rgba(0,0,0,0.6);
  }
  .tghh-dyn-subtitle {
    font-size: 1.05rem;
    color: #FBBF24 !important;
    font-weight: 700;
    margin-bottom: 18px;
  }
  .tghh-quote-box {
    border-left: 4px solid #FBBF24 !important;
    background: rgba(251,191,36,0.08) !important;
    padding: 16px 20px;
    border-radius: 0 16px 16px 0;
    margin: 20px 0;
    font-style: italic;
    color: #FDE68A !important;
    font-size: 1.1rem;
    line-height: 1.55;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    position: relative;
  }
  .tghh-quote-mark {
    font-size: 2.8rem;
    color: rgba(251,191,36,0.25);
    position: absolute;
    top: -8px;
    left: 8px;
    user-select: none;
    font-family: serif;
  }
  .tghh-lore-card {
    background: rgba(255,255,255,0.03) !important;
    border: 1px solid rgba(251,191,36,0.2) !important;
    border-radius: 18px;
    padding: 18px;
    margin: 18px 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #FFF8E7;
  }
  .tghh-stats-row {
    display: flex;
    justify-content: space-around;
    align-items: center;
    background: rgba(255,255,255,0.04) !important;
    border: 1px solid rgba(251,191,36,0.3) !important;
    border-radius: 18px;
    padding: 14px 16px;
    margin: 20px 0;
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  }
  .tghh-card-flip-wrap {
    perspective: 1000px;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 53.98/85.60;
    margin: 18px auto;
    cursor: pointer;
  }
  .tghh-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }
  .tghh-card-flip-wrap.flipped .tghh-card-inner {
    transform: rotateY(180deg);
  }
  .tghh-card-face {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid #FBBF24;
    box-shadow: 0 8px 30px rgba(0,0,0,0.6);
  }
  .tghh-card-face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tghh-card-back {
    transform: rotateY(180deg);
  }
  .tghh-ability-box {
    background: linear-gradient(135deg, rgba(28, 18, 12, 0.95), rgba(20, 12, 8, 0.95)) !important;
    border: 1.5px solid rgba(251, 191, 36, 0.35) !important;
    border-radius: 18px;
    padding: 16px 20px;
    margin: 16px 0;
    box-shadow: 0 6px 20px rgba(0,0,0,0.35);
  }
  .tghh-nfc-motif-box {
    background: linear-gradient(135deg, rgba(26, 16, 11, 0.95), rgba(18, 11, 7, 0.95)) !important;
    border: 1.5px solid rgba(251, 191, 36, 0.35) !important;
    border-radius: 18px;
    padding: 16px 20px;
    margin: 16px 0;
    box-shadow: 0 6px 20px rgba(0,0,0,0.35);
  }
  .tghh-radar-rings {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .tghh-radar-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #FBBF24;
    animation: liveDotPulse 1.8s infinite;
  }
  .tghh-radar-ring {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid #FBBF24;
    animation: liveDotPulse 1.8s infinite 0.3s;
  }

</style>

<div class="tg-set-wrapper">
  <div class="tg-set-container">

    <!-- 1. CARD MULTIMEDIA & ARTWORK SHOWCASE (At Top of Page) -->
    <div class="tg-media-section">
      
      <!-- Main Media Viewport -->
      <div class="tg-media-viewport" id="tg-media-box">
        
        <!-- Slide 1: Video -->
