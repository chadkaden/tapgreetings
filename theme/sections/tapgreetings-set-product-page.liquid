  var activeSlide = 1;

  // Touch Swipe for Multimedia (Swipe left for next, swipe right for prev)
  (function initSetMediaSwipe() {
    var mediaBox = document.getElementById('tg-media-box');
    if (!mediaBox) return;

    var startX = 0;
    var startY = 0;
    var startTime = 0;

    mediaBox.addEventListener('touchstart', function(e) {
      if (e.touches.length === 1) {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        startTime = Date.now();
      }
    }, { passive: true });

    mediaBox.addEventListener('touchend', function(e) {
      if (e.changedTouches.length === 1) {
        var deltaX = e.changedTouches[0].clientX - startX;
        var deltaY = e.changedTouches[0].clientY - startY;
        var elapsed = Date.now() - startTime;
        if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY) * 1.3 && elapsed < 600) {
          if (deltaX < 0) {
            var next = activeSlide >= 4 ? 1 : activeSlide + 1;
            switchMediaSlide(next);
          } else {
            var prev = activeSlide <= 1 ? 4 : activeSlide - 1;
            switchMediaSlide(prev);
          }
        }
      }
    }, { passive: true });
  })();

  function switchMediaSlide(n) {
    activeSlide = n;
    for (var i = 1; i <= 4; i++) {
      var slide = document.getElementById('tg-slide-' + i);
      var btn = document.getElementById('tg-media-btn-' + i);
      if (slide) slide.classList.remove('active-slide');
      if (btn) btn.classList.remove('active');
    }

    var targetSlide = document.getElementById('tg-slide-' + n);
    var targetBtn = document.getElementById('tg-media-btn-' + n);
    if (targetSlide) targetSlide.classList.add('active-slide');
    if (targetBtn) targetBtn.classList.add('active');

    var cardVid = document.getElementById('tg-card-video');
    var tapVid = document.getElementById('tg-tap-video');

    if (n === 1 && cardVid) {
      if (tapVid) tapVid.pause();
      cardVid.play();
    } else if (n === 4 && tapVid) {
      if (cardVid) cardVid.pause();
      tapVid.play();
    } else {
      if (cardVid) cardVid.pause();
      if (tapVid) tapVid.pause();
    }
  }

  function toggleSound() {
    var vid = document.getElementById('tg-card-video');
    var btn = document.getElementById('tg-sound-btn');
    if (!vid) return;
    vid.muted = !vid.muted;
    if (btn) btn.innerText = vid.muted ? '🔇' : '🔊';
  }

  function selectVariantById(variantId) {
    variantId = String(variantId);
    var hiddenInput = document.getElementById('tg-selected-variant-id');
    var select = document.getElementById('tg-variant-select');
    var livePrice = document.getElementById('tg-live-price');
    var liveCompare = document.getElementById('tg-live-compare');
    var savingsBadge = document.getElementById('tg-savings-badge');
    var btnPriceTop = document.getElementById('tg-btn-price-top');
    var btnPriceBottom = document.getElementById('tg-btn-price-bottom');
    var btnPriceShowcase = document.getElementById('tg-btn-price-bottom-showcase');

    if (hiddenInput) hiddenInput.value = variantId;
    if (select && select.value !== variantId) select.value = variantId;

    // Update active thumbnail in variant reel
    document.querySelectorAll('.tg-var-btn').forEach(function(btn) {
      btn.classList.remove('active');
    });
    var activeThumb = document.getElementById('tg-var-thumb-' + variantId);
    if (activeThumb) {
      activeThumb.classList.add('active');
      activeThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    // Get pricing details from select option
    if (select) {
      var opt = select.querySelector('option[value="' + variantId + '"]');
      if (opt) {
        var price = opt.getAttribute('data-price');
        var compare = opt.getAttribute('data-compare');
        var rawPrice = parseInt(opt.getAttribute('data-raw-price') || '0', 10);
        var rawCompare = parseInt(opt.getAttribute('data-raw-compare') || '0', 10);

        if (livePrice) livePrice.innerText = price;
        if (btnPriceTop) btnPriceTop.innerText = price;
        if (btnPriceBottom) btnPriceBottom.innerText = price;
        if (btnPriceShowcase) btnPriceShowcase.innerText = price;

        if (rawCompare > rawPrice) {
          if (liveCompare) {
            liveCompare.style.display = 'inline';
            liveCompare.innerText = compare;
          }
          if (savingsBadge) {
            savingsBadge.style.display = 'inline-block';
            savingsBadge.innerText = 'Save $40.84 (17% OFF)';
          }
        } else {
          if (liveCompare) liveCompare.style.display = 'none';
          if (savingsBadge) savingsBadge.style.display = 'none';
        }
      }
    }

    // Dynamic media updates based on variant
    var meta = variantMeta[variantId];
    if (meta) {
      var frontImg = document.getElementById('tg-front-img');
      var backImg = document.getElementById('tg-back-img');
      var cardVid = document.getElementById('tg-card-video');
      var vidSource = document.getElementById('tg-video-source');

      if (frontImg && meta.front) frontImg.src = meta.front;
      if (backImg && meta.back) backImg.src = meta.back;
      if (cardVid && vidSource && meta.video) {
        vidSource.src = meta.video;
        cardVid.load();
        cardVid.play();
      }
    }
  }

  function submitActiveForm() {
    var form = document.getElementById('tg-set-form');
    if (form) form.submit();
  }

  // Pre-select variant from URL parameter (?variant=...)
  document.addEventListener('DOMContentLoaded', function() {
    var params = new URLSearchParams(window.location.search);
    var vParam = params.get('variant');
    if (vParam && variantMeta[vParam]) {
      selectVariantById(vParam);
    }
  });
</script>
