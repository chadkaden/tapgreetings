<script>
  // Material Design Vector SVGs for Dark Mode & Light Mode
  var MATERIAL_DARK_SVG = '<svg xmlns="http://www.w3.org/2000/svg" height="22" viewBox="0 -960 960 960" width="22" fill="currentColor"><path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Z"/></svg>';
  var MATERIAL_LIGHT_SVG = '<svg xmlns="http://www.w3.org/2000/svg" height="22" viewBox="0 -960 960 960" width="22" fill="currentColor"><path d="M480-360q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35Zm0 80q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Z"/></svg>';

  // Apply department & mode classes to html and body elements
  (function() {
    var dept = "{{ dept_id }}";
    var body = document.body;
    var html = document.documentElement;
    body.classList.add('dept-' + dept);
    html.classList.add('dept-' + dept);

    var savedMode = localStorage.getItem('tapthingy_theme_mode');
    if (savedMode === 'light') {
      body.classList.remove('tt-dark-mode');
      body.classList.add('tt-light-mode');
      html.classList.remove('tt-dark-mode');
      html.classList.add('tt-light-mode');
    } else {
      body.classList.remove('tt-light-mode');
      body.classList.add('tt-dark-mode');
      html.classList.remove('tt-light-mode');
      html.classList.add('tt-dark-mode');
    }
  })();

  function toggleTtDepartmentTheme() {
    var body = document.body;
    var html = document.documentElement;
    var isDark = body.classList.contains('tt-dark-mode') || html.classList.contains('tt-dark-mode');

    if (isDark) {
      body.classList.remove('tt-dark-mode');
      body.classList.add('tt-light-mode');
      html.classList.remove('tt-dark-mode');
      html.classList.add('tt-light-mode');
      localStorage.setItem('tapthingy_theme_mode', 'light');
    } else {
      body.classList.remove('tt-light-mode');
      body.classList.add('tt-dark-mode');
      html.classList.remove('tt-light-mode');
      html.classList.add('tt-dark-mode');
      localStorage.setItem('tapthingy_theme_mode', 'dark');
    }

    updateTtNavToggleButtons();
  }

  function updateTtNavToggleButtons() {
    var isDark = document.body.classList.contains('tt-dark-mode') || document.documentElement.classList.contains('tt-dark-mode');
    
    // Update Header Icon Action Button
    var iconBtns = document.querySelectorAll('.tt-nav-toggle-icon-btn');
    iconBtns.forEach(function(btn) {
      btn.innerHTML = isDark ? MATERIAL_DARK_SVG : MATERIAL_LIGHT_SVG;
      btn.setAttribute('title', isDark ? 'Switch to Light Mode' : 'Switch to Dark Mode');
      btn.setAttribute('aria-label', isDark ? 'Switch to Light Mode' : 'Switch to Dark Mode');
    });

    // Update Mobile Drawer Text Item
    var drawerBtns = document.querySelectorAll('.tt-drawer-theme-btn');
    drawerBtns.forEach(function(btn) {
      btn.innerHTML = isDark ? '🌙 Dark Mode (Tap for Light)' : '☀️ Light Mode (Tap for Dark)';
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    var body = document.body;
    var savedMode = localStorage.getItem('tapthingy_theme_mode');

    if (savedMode === 'light') {
      body.classList.remove('tt-dark-mode');
      body.classList.add('tt-light-mode');
    } else {
      body.classList.remove('tt-light-mode');
      body.classList.add('tt-dark-mode');
    }

    // 1. Inject Material SVG Icon Button DIRECTLY INSIDE <header-actions> on exact same line
    var headerActions = document.querySelector('header-actions') || 
                        document.querySelector('.header-actions') || 
                        document.querySelector('.header__column--right') || 
                        document.querySelector('.header__row--top');

    if (headerActions && !document.querySelector('.tt-nav-toggle-icon-btn')) {
      var iconBtn = document.createElement('button');
      iconBtn.type = 'button';
      iconBtn.className = 'header-actions__action tt-nav-toggle-icon-btn';
      iconBtn.onclick = toggleTtDepartmentTheme;
      
      // Insert right at beginning of header-actions row so it sits on exact same line
      headerActions.insertBefore(iconBtn, headerActions.firstChild);
    }

    // 2. Inject Text Button into Mobile Navigation Drawer Menu
    var drawerNav = document.querySelector('.menu-drawer__navigation') || 
                      document.querySelector('.menu-drawer') || 
                      document.querySelector('.drawer__content');

    if (drawerNav && !document.querySelector('.tt-drawer-theme-btn')) {
      var drawerBtn = document.createElement('button');
      drawerBtn.type = 'button';
      drawerBtn.className = 'tt-drawer-theme-btn';
      drawerBtn.onclick = toggleTtDepartmentTheme;
      drawerNav.appendChild(drawerBtn);
    }

    updateTtNavToggleButtons();
  });
</script>
