{% comment %}
  TapThingy Department Theme & Header Controller (Flawless Background & Card Theme Switching)
  Enforces 100% background and card color switching across all departments (TapThingy, Pink-O-Ween, DipDen, SOSATS, Tap Qard, Tap Photo Cards).
{% endcomment %}

{% assign dept_id = 'tapthingy' %}
{% assign dept_name = 'TapThingy' %}
{% assign dept_announcement = '🛸 TAPTHINGY.COM • Smart Cards, Confectionery & Innovations' %}

{% if collection.handle contains 'pink-o-ween' or product.tags contains 'Pink-O-Ween' or product.type contains 'Pink-O-Ween' or template.suffix == 'pinkoween' %}
  {% assign dept_id = 'pinkoween' %}
  {% assign dept_name = 'Tap Greetings • Pink-O-Ween' %}
  {% assign dept_announcement = '💌 TAP GREETINGS • Pink-O-Ween 31-Card Coven Franchise' %}
{% elsif collection.handle contains 'dipden' or product.type contains 'Confectionery' or product.tags contains 'DipDen' or product.title contains 'DipDen' %}
  {% assign dept_id = 'dipden' %}
  {% assign dept_name = 'DipDen Confectionery' %}
  {% assign dept_announcement = '🍬 DIPDEN™ CONFECTIONERY • Sweets, Candies & Dipping Treats' %}
{% elsif collection.handle contains 'sosats' or product.title contains 'Pizza Mystery' or product.tags contains 'SOSATS' or product.type contains 'Mystery' %}
  {% assign dept_id = 'sosats' %}
  {% assign dept_name = 'SOSATS & Pizza Mystery' %}
  {% assign dept_announcement = '⚡ SOSATS™ INNOVATIONS • Pizza Mystery™ & Mystery Games' %}
{% elsif collection.handle contains 'tap-qard' or product.type contains 'Business Card' or product.tags contains 'TapQard' %}
  {% assign dept_id = 'tapqard' %}
  {% assign dept_name = 'Tap Qard' %}
  {% assign dept_announcement = '🎴 TAPQARD™ • Smart Contactless NFC Business Cards' %}
{% elsif collection.handle contains 'tap-photo' or product.tags contains 'TapPhotoCards' %}
  {% assign dept_id = 'tapphoto' %}
  {% assign dept_name = 'Tap Photo Cards' %}
  {% assign dept_announcement = '🖼️ TAPPHOTOCARDS™ • Personalized Video Memory Keepsakes' %}
{% endif %}

